{%- liquid
  assign main_image = product.featured_media
  assign hover_image = product.media[1]
  assign main_image_alt = main_image.alt | default: product.title
  assign image_sizes = '(min-width: 768px) 355px, 50vw'

  assign loading = 'eager'
  if lazy_load
    assign loading = 'lazy'
  endif

  assign rating = product.metafields.reviews.rating.value.rating
  assign review_count = product.metafields.reviews.rating_count.value | default: 0 | plus: 0

  if review_count >= 1000
    assign thousands = review_count | divided_by: 1000
    assign rest = review_count | modulo: 1000 | prepend: '00' | slice: -3, 3
    assign review_count = thousands | append: ',' | append: rest
  endif
-%}

<li class="tw:md:w-(--card-width) tw:md:shrink-0 {% if hidden_on_mobile %}tw:max-md:invisible{% endif %}">
  <best-seller-card class="tw:block tw:pb-2 tw:md:pb-4">
    <a href="{{ product.url }}" tabindex="-1" class="tw:group tw:relative tw:block tw:aspect-[158/159] tw:overflow-hidden tw:md:aspect-square tw:rounded-(--card-radius) tw:bg-gray-100">
      {%- if main_image -%}
        {{ main_image | image_url: width: 710 | image_tag: loading: loading, widths: '300, 400, 600, 710', sizes: image_sizes, alt: main_image_alt, class: 'product-image' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-image' }}
      {%- endif -%}

      {%- comment -%} Fades in on top of the main image on hover; no hover effect without a second image {%- endcomment -%}
      {%- if section_settings.show_secondary_image and hover_image.media_type == 'image' -%}
        {{ hover_image | image_url: width: 710 | image_tag: loading: 'lazy', widths: '300, 400, 600, 710', sizes: image_sizes, alt: '', class: 'product-image tw:opacity-0 tw:group-hover:opacity-100' }}
      {%- endif -%}

      {%- if section_settings.show_best_seller_badge -%}
        <span class="badge">{{ section_settings.best_seller_badge_label | escape }}</span>
      {%- endif -%}

      {%- if section_settings.show_sale_badge and product.compare_at_price > product.price -%}
        {%- assign discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
        <span class="badge badge-sale">{{ section_settings.sale_badge_label | escape }} {{ discount }}%</span>
      {%- endif -%}
    </a>

    <div class="tw:mt-3 tw:flex tw:flex-col tw:gap-2 tw:px-2 tw:md:mt-4 tw:md:px-3">
      <h3 class="product-title">
        <a href="{{ product.url }}" class="tw:hover:underline">{{ product.title | escape }}</a>
      </h3>

      {%- if section_settings.show_rating and rating -%}
        <p class="product-reviews tw:flex tw:items-center tw:gap-1 tw:whitespace-nowrap">
          <span class="tw:flex tw:gap-0.5" aria-hidden="true">{% render 'best-seller-stars', rating: rating %}</span>
          <span class="tw:sr-only">Rated {{ rating }} out of 5,</span>
          {{ review_count }} Reviews
        </p>
      {%- endif -%}

      <p class="tw:font-medium">{{ product.price | money }}</p>
    </div>
  </best-seller-card>
</li>
